# Local development defaults
APP_ENV=development
EDNAI_PROVIDER=disabled
EDNAI_MODEL=NCAIR1/N-ATLaS
EDNAI_UPSTREAM_BASE_URL=
EDNAI_UPSTREAM_API_KEY=
EDNAI_GRADIO_SPACE_ID=
HF_TOKEN=
EDNAI_ADMIN_TOKEN=change-me

# Persistence. Production must use EDNAI_DATABASE_URL.
EDNAI_DATABASE_PATH=/tmp/ednai.sqlite3
EDNAI_DATABASE_URL=

# Developer platform
EDNAI_AUTH_ENABLED=true
EDNAI_DEMO_ACCOUNT_ENABLED=true
EDNAI_ALLOW_PUBLIC_DEMO_ACCOUNT=false
EDNAI_DEMO_EMAIL=demo@edn.com
EDNAI_DEMO_PASSWORD=12345
EDNAI_DEMO_CREDIT_USD=10
EDNAI_SESSION_HOURS=24

# Pricing. Set EDNAI_PRICING_MODE=production only after commercial rates are approved.
EDNAI_PRICING_MODE=demo
EDNAI_INPUT_USD_PER_1M_TOKENS=0.50
EDNAI_OUTPUT_USD_PER_1M_TOKENS=1.50
EDNAI_REQUIRE_EXACT_USAGE=true

# Abuse controls (application fallback; use Azure APIM/Front Door for distributed enforcement)
EDNAI_LOGIN_RATE_LIMIT_PER_MINUTE=10
EDNAI_API_RATE_LIMIT_PER_MINUTE=60

# Network policy
TRUSTED_HOSTS=*
CORS_ORIGINS=http://localhost:8000
