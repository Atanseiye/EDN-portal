{
  "name": "ednai",
  "main": "runtime/worker.py",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "python_workers",
    "python_workers_314"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EDNAiContainer"
      ]
    },
    {
      "tag": "v2",
      "deleted_classes": [
        "EDNAiContainer"
      ]
    }
  ]
}
