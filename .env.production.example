# SAFE TEMPLATE ONLY — never commit real secret values.
APP_ENV=production

EDNAI_PROVIDER=gradio_space
EDNAI_MODEL=NCAIR1/N-ATLaS
EDNAI_GRADIO_SPACE_ID=KoladeOdunope/ednai-natlas-runtime
HF_TOKEN=__SET_FROM_CLOUDFLARE_SECRET__
EDNAI_ADMIN_TOKEN=__SET_FROM_CLOUDFLARE_SECRET_32_PLUS_CHARS__

# Durable persistence is mandatory in production.
EDNAI_DATABASE_URL=postgresql://__USER__:__PASSWORD__@__NEON_HOST__/neondb?sslmode=require

# Real-user control plane.
EDNAI_AUTH_ENABLED=true
EDNAI_SESSION_HOURS=24
EDNAI_MAX_API_KEYS_PER_ACCOUNT=10

# A real-user production deployment must not expose the shared weak demo account.
EDNAI_DEMO_ACCOUNT_ENABLED=false
EDNAI_ALLOW_PUBLIC_DEMO_ACCOUNT=false

# Deploy demo credentials only in a separate demo environment:
# EDNAI_DEMO_ACCOUNT_ENABLED=true
# EDNAI_ALLOW_PUBLIC_DEMO_ACCOUNT=true
# EDNAI_DEMO_EMAIL=demo@edn.com
# EDNAI_DEMO_PASSWORD=12345

# Billing must be exact and pricing must be explicitly promoted.
EDNAI_PRICING_MODE=production
EDNAI_INPUT_USD_PER_1M_TOKENS=__APPROVED_RATE__
EDNAI_OUTPUT_USD_PER_1M_TOKENS=__APPROVED_RATE__
EDNAI_REQUIRE_EXACT_USAGE=true

EDNAI_LOGIN_RATE_LIMIT_PER_MINUTE=10
EDNAI_API_RATE_LIMIT_PER_MINUTE=60

# Replace with the actual Cloudflare Workers/custom-domain hosts and HTTPS origins.
TRUSTED_HOSTS=ednai.example.com
CORS_ORIGINS=https://ednai.example.com
